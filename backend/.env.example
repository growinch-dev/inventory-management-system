PORT=5000
MONGODB_URI=mongodb://localhost:27017/major-surgical-inventory
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
NODE_ENV=development

# Email Configuration (for invoices)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Company Details
COMPANY_NAME=Major Surgical Co.
COMPANY_ADDRESS=Chandni Chowk, New Delhi, Delhi 110006
COMPANY_PHONE=+91-8047670955
COMPANY_EMAIL=info@majorsurgical.com
COMPANY_GST=07XXXXX1234X1ZX

# Razorpay Configuration (for subscriptions)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Razorpay Plan IDs (create these in Razorpay Dashboard)
RAZORPAY_PLAN_STARTER_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_STARTER_YEARLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_PRO_MONTHLY=plan_xxxxxxxxxxxx
RAZORPAY_PLAN_PRO_YEARLY=plan_xxxxxxxxxxxx

# Frontend URL (for emails and redirects)
FRONTEND_URL=http://localhost:5173
