# ============================================================================
#  GrowInch Inventory — backend environment
#  Copy this file to `.env` and fill in the values for the chosen deployment.
# ============================================================================

# --- Server ---
PORT=5001
NODE_ENV=production

# Serve the built React app from this same server (single-server deployment).
# Set to "true" for local/on-premise and for a single online server.
SERVE_CLIENT=true

# Allowed browser origins for CORS (comma-separated). Not needed when the API
# serves the client from the same origin. Use "*" via CORS_ORIGIN to allow any
# origin (handy for LAN access during setup).
FRONTEND_URL=http://localhost:5001
# CORS_ORIGIN=*

# --- Database ---
# ONLINE (MongoDB Atlas, needs internet):
#   MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxx.mongodb.net/growinch-inventory?retryWrites=true&w=majority
#   # Only if the host's DNS refuses SRV lookups (e.g. Cloudflare WARP on Windows):
#   # DNS_SERVERS=8.8.8.8,1.1.1.1
#
# LOCAL / OFFLINE (MongoDB running on the same machine or Docker network):
#   MONGODB_URI=mongodb://127.0.0.1:27017/growinch-inventory
MONGODB_URI=mongodb://127.0.0.1:27017/growinch-inventory

# --- Auth ---
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=7d

# --- Email (optional; alerts/invites). Leave blank to disable. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
